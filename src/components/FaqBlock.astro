---
type FaqItem = {
  q: string;
  a: string;
};

export type Props = {
  items: FaqItem[];
  title?: string;
};

const { items, title = 'Частые вопросы' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="section section--tight" data-faq>
  <div class="container">
    <h2>{title}</h2>

    <div class="stack" style="margin-top:20px;max-width:820px;">
      {
        items.map((item) => (
          <details class="panel">
            <summary style="cursor:pointer;font-weight:650;">{item.q}</summary>
            <p class="muted" style="margin-top:10px;">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline data-faq-schema></script>
